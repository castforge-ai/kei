{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://github.com/castforge-ai/kei/blob/main/docs/schemas/plan.schema.json",
 "title": "Kei plan (plan/plan.json)",
 "description": "The key poses of the plan stage and the locked delivery camera. The P7 gate also needs PLAN.md's X-sheet.",
 "type": "object",
 "required": [
  "keys"
 ],
 "properties": {
  "keys": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "object",
    "required": [
     "f",
     "function"
    ],
    "properties": {
     "f": {
      "type": "integer"
     },
     "function": {
      "type": "string"
     },
     "kind": {
      "type": "string"
     },
     "note": {
      "type": "string"
     },
     "drawing": {
      "type": "string"
     },
     "views": {
      "type": "object"
     }
    }
   }
  },
  "camera": {
   "type": "object",
   "properties": {
    "yaw_deg": {
     "type": "number"
    },
    "pitch_deg": {
     "type": "number"
    },
    "target_m": {
     "type": "array",
     "items": {
      "type": "number"
     },
     "minItems": 3,
     "maxItems": 3
    },
    "span_m": {
     "type": "number"
    },
    "lens_mm": {
     "type": "number"
    },
    "distance_m": {
     "type": "number"
    },
    "sensor_mm": {
     "type": "number"
    },
    "aspect": {
     "type": "number"
    },
    "follow": {
     "type": "boolean"
    },
    "keys": {
     "type": "array",
     "minItems": 1,
     "description": "an animated camera: each key changes some settings from frame f; between keys it eases, and a key with cut true starts a new setup",
     "items": {
      "type": "object",
      "required": [
       "f"
      ],
      "properties": {
       "f": {
        "type": "integer",
        "minimum": 0
       },
       "cut": {
        "type": "boolean"
       },
       "yaw_deg": {
        "type": "number"
       },
       "pitch_deg": {
        "type": "number"
       },
       "target_m": {
        "type": "array",
        "items": {
         "type": "number"
        },
        "minItems": 3,
        "maxItems": 3
       },
       "span_m": {
        "type": "number"
       },
       "lens_mm": {
        "type": "number"
       },
       "distance_m": {
        "type": "number"
       },
       "sensor_mm": {
        "type": "array",
        "items": {
         "type": "number"
        },
        "minItems": 2,
        "maxItems": 2
       }
      }
     }
    },
    "name": {
     "type": "string"
    }
   }
  },
  "fps": {
   "type": "number",
   "exclusiveMinimum": 0
  },
  "frames": {
   "type": "integer",
   "minimum": 1
  },
  "loop": {
   "type": "boolean"
  }
 }
}
